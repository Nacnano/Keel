      "html": "<button class=\"ds-btn-primary\">Listening options</button>",
      "css": ".ds-btn-primary{height:44px;padding:0 16px;border:0;border-radius:var(--radius-control,10px);background:var(--jk-action);color:var(--jk-accent-fg);font-family:var(--font-sans);font-size:15px;font-weight:600;transition:background-color 150ms,color 150ms,filter 150ms,transform 150ms}.ds-btn-primary:hover{filter:brightness(1.1)}.ds-btn-primary:active{filter:brightness(.95);transform:scale(.98)}.ds-btn-primary:disabled{opacity:.4;pointer-events:none}.ds-btn-primary:focus-visible{outline:2px solid var(--jk-accent);outline-offset:2px;border-radius:6px}"
    },
