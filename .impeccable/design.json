  "narrative": {
    "northStar": "Apple recording utility",
    "overview": "Keel follows the user-pinned Voice Memos / GarageBand utility direction: modern, calm and uncomplicated. Native system typography, semantic light/dark surfaces, grouped controls and restrained blue actions support use at a piano bench. These are interface references, with no Apple affiliation implied.\n\nThe shipped system gives the current task room, uses readable secondary labels, and moves infrequent controls into deliberate sheets. Chord recognition is presented as an estimate with explicit strength labels; screenshots and the demo establish interface behavior, not real-instrument accuracy.",
    "keyCharacteristics": [
      "Semantic light and dark surfaces.",
      "One dominant action and an oversized live chord.",
      "Grouped controls, labeled SVG icons and responsive sheets."
    ],
    "rules": [
      {
        "name": "The Action Contrast Rule",
        "body": "Use action for a filled control with white text; use accent for text, selection and notation. Dark mode changes accent while action retains its light-root value.",
        "section": "colors"
      },
      {
        "name": "The Bench Hierarchy Rule",
        "body": "The live chord dominates. Roman numeral, match strength and key remain subordinate; long chord symbols scale down without wrapping.",
        "section": "typography"
      },
      {
        "name": "The Surface Depth Rule",
        "body": "Use tonal surfaces and hairlines for ordinary content; reserve elevated shadows for overlays and selection affordances.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep primary actions and navigation at least 44px high; large listening actions are 52px.",
      "Do show chord match strength in words, alongside the estimate.",
      "Do use the supplied semantic tokens for both themes and preserve visible keyboard focus.",
      "Do keep the demo explicitly labeled and separate from microphone access and saving."
    ],
    "donts": [
      "Don't invent accuracy claims or Apple affiliation.",
      "Don't rely on color alone to communicate chord confidence or recording state.",
      "Don't promote compact legacy control dimensions into the touch target standard."
    ]
  }
}
